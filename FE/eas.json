{
  "cli": {
    "version": ">= 15.0.13",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "unsigned": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "local",
        "artifactPath": "ios/build/App.ipa"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
